node_modules/
vendor/
dist/
*.log
.DS_Store
__pycache__/
.cache/
.venv/
data/qa-cache/
.claude/worktrees/
sim/results/

# Arena: API keys and locally cached Bandai card art (never redistribute)
.env
arena/.cache/
arena/results/
# Decision logs are working output: one file per run, ~400 KB per ST01 game. A game worth KEEPING
# (a human game, a council game with real dissent) gets copied to arena/corpus/, which is tracked.
arena/logs/

# Mutation sweep: the per-worker engine clones and the workers' console logs. The sweep's actual
# results live in runs/*.jsonl, which IS tracked.
.clones/
runs/*.out

# Upstream engine clone for baseline measurements (CLAUDE.md: "measure upstream facts in a CLEAN
# upstream clone, never in vendor/"). Its WORKING TREE may carry applied patches; the pristine
# reference is its git HEAD — read baselines with `git show HEAD:<path>`, not from the tree.
.engine-base/

# Disposable per-worker engine clones (cp -Rc vendor/tcg-engines, APFS copy-on-write). One per
# worker is mandatory for runs/mutation_shard.py: mutation_check writes its mutant into the
# cards package next to the engine it is given, so a shared tree makes every verdict noise.
.mut/

# `--fresh` in runs/mutation_shard.py sets the previous per-set results aside here before a re-run.
# Useful for cross-checking two independent runs record-for-record; not a deliverable.
runs/*.jsonl.prev

# The mid-card sidecar mutation_sweep.py writes so a budget stop loses at most one card. It holds a
# partially-measured card's state, so a committed one would read as a record rather than scratch.
runs/*.jsonl.progress.json
